# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in the blanks.
# Never commit the real .env.

APP_NAME=recapdam
APP_ENV=production
APP_DEBUG=false
# Generate with: docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
# Public address, exactly as users open it (https, no trailing slash).
APP_URL=https://recapdam.example.gob.mx
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# Port on 127.0.0.1 where the host's Apache reaches the app. Must be free on the server.
APP_PORT=8090

# Logs go to `docker compose logs app`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The database is the "db" container from docker-compose.prod.yml (host and port are set there).
# These values create it on first start; use a long random password.
DB_DATABASE=recapdam
DB_USERNAME=recapdam
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
BCRYPT_ROUNDS=12
